# Ignore environment variables and secrets
.env
.env.*
!.env.example

# Ignore local databases and temp data
*.db
*.db-shm
*.db-wal
data/
backups/
logs/
uploads/*
!uploads/.gitkeep

# Ignore python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
.venv/
env/
venv/

# Ignore git
.git/
.gitignore
.github/
.vscode/
.idea/
